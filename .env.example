# Jeldi server configuration. Copy to .env (never commit .env).
# Only variables the code actually reads are listed here.

# ---- Required (startup fails without these) ----
DATABASE_URL=postgresql://user:password@host/db?sslmode=require
JWT_SECRET=                      # openssl rand -base64 64  (min 32 chars)
TOKEN_ENCRYPTION_KEY=            # openssl rand -hex 32     (AES-256 key for stored OAuth tokens / API keys)

# ---- Runtime ----
NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:5000     # used for OAuth redirects and allowed origins
# AWS_DOMAIN=https://overlay.jeldi.app # set on AWS; also marks the platform as "aws"
# ALLOWED_DOMAINS=demo.jeldi.app,overlay.jeldi.app

# ---- ERP sync (Epicor / SyteLine connectors) ----
# ERP_SYNC_INTERVAL_MINUTES=15   # in-process scheduler for the long-running server; Lambda uses serverless.yml schedule
# ERP_SYNC_HISTORY_DAYS=400      # how far back each sync pulls transactions

# ---- AI ----
OPENAI_API_KEY=                  # AI assistant / insights endpoints fail without it

# ---- Demo deployment only ----
# DEMO_MODE=true                 # seeds demo users + data and enables POST /api/auth/demo-login
# DEMO_USER_PASSWORD=            # password for the seeded demo accounts (random per process if unset)

# ---- Sign-in with Google / Microsoft (optional) ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# AWS_GOOGLE_CALLBACK_URL=https://overlay.jeldi.app/api/auth/google/callback

# ---- Email OAuth (Gmail / Outlook.com) ----
# EMAIL_OAUTH_REDIRECT_URI=https://overlay.jeldi.app/api/email/callback
# GMAIL_CLIENT_ID=               # defaults to GOOGLE_CLIENT_ID
# EMAIL_FROM=
# SMTP_HOST=

# ---- ERP OAuth client ids (optional, one per system) ----
# OAUTH_REDIRECT_URI=https://overlay.jeldi.app/api/erp/callback
# SAP_CLIENT_ID=            SAP_CLIENT_SECRET=
# NETSUITE_CLIENT_ID=       NETSUITE_CLIENT_SECRET=
# DYNAMICS_CLIENT_ID=       DYNAMICS365_CLIENT_SECRET=
# ORACLE_FUSION_CLIENT_ID=  WORKDAY_CLIENT_ID=  IFS_CLIENT_ID=  EPICOR_CLIENT_ID=
# INFOR_CLIENT_ID=          ACUMATICA_CLIENT_ID=  SAGE_CLIENT_ID=  SYTELINE_CLIENT_ID=
