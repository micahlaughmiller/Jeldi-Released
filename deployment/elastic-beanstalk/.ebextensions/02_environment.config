option_settings:
  aws:elasticbeanstalk:application:environment:
    NODE_ENV: production
    PORT: 5000
    NPM_USE_PRODUCTION: true
    
  aws:elasticbeanstalk:container:nodejs:
    NodeCommand: "npm start"
    NodeVersion: 18.17.0
    GzipCompression: true
    ProxyServer: nginx
    
  aws:autoscaling:launchconfiguration:
    SecurityGroups: 
      - sg-12345678  # Replace with your security group ID
    IamInstanceProfile: aws-elasticbeanstalk-ec2-role
    InstanceType: t3.medium
    EC2KeyName: your-keypair-name  # Replace with your key pair name
    
  aws:autoscaling:asg:
    MinSize: 1
    MaxSize: 10
    Availability Zones: Any 2
    
  aws:elasticbeanstalk:environment:
    ServiceRole: aws-elasticbeanstalk-service-role
    LoadBalancerType: application
    
  aws:elbv2:loadbalancer:
    SecurityGroups: 
      - sg-12345678  # Replace with your security group ID
    ManagedSecurityGroup: true
    
  aws:elbv2:listener:80:
    Protocol: HTTP
    Rules: default
    
  aws:elbv2:listener:443:
    Protocol: HTTPS
    SSLCertificateArns: arn:aws:acm:region:account:certificate/cert-id  # Replace with your SSL certificate ARN
    Rules: default
    
  aws:elasticbeanstalk:healthreporting:system:
    SystemType: enhanced
    HealthCheckSuccessThreshold: Ok
    
  aws:elasticbeanstalk:environment:process:default:
    HealthCheckPath: /api/health
    HealthCheckInterval: 15
    HealthyThresholdCount: 2
    UnhealthyThresholdCount: 5
    Port: 5000
    Protocol: HTTP
    StickinessEnabled: false
    
  aws:elasticbeanstalk:cloudwatch:logs:
    StreamLogs: true
    DeleteOnTerminate: true
    RetentionInDays: 7
    
  aws:elasticbeanstalk:cloudwatch:logs:health:
    HealthStreamingEnabled: true
    DeleteOnTerminate: true
    RetentionInDays: 7