files:
  "/opt/elasticbeanstalk/tasks/taillogs.d/01-app-logs.conf":
    mode: "000644"
    owner: root
    group: root
    content: |
      /var/log/app/*.log
      /var/log/nginx/access.log
      /var/log/nginx/error.log

  "/etc/cron.d/cleanup_logs":
    mode: "000644"
    owner: root
    group: root
    content: |
      # Clean up old log files daily
      0 2 * * * root find /var/log/app -name "*.log" -type f -mtime +7 -delete
      0 2 * * * root find /var/log/nginx -name "*.log" -type f -mtime +7 -delete

commands:
  01_create_health_check:
    command: |
      cat > /tmp/health_check.sh << 'EOF'
      #!/bin/bash
      # Custom health check script
      
      # Check if the application is responding
      response=$(curl -s -o /dev/null -w "%{http_code}" http://localhost:5000/api/health)
      
      if [ "$response" = "200" ]; then
        echo "Health check passed"
        exit 0
      else
        echo "Health check failed with status $response"
        exit 1
      fi
      EOF
      
      chmod +x /tmp/health_check.sh
      mv /tmp/health_check.sh /opt/elasticbeanstalk/bin/health_check.sh

container_commands:
  01_setup_health_endpoint:
    command: |
      # Ensure health endpoint exists in the application
      if ! grep -q "/api/health" /var/app/staging/server/routes.ts; then
        echo "Warning: /api/health endpoint not found in application"
      fi
    
  02_install_dependencies:
    command: npm ci --production
    cwd: /var/app/staging
    
  03_build_application:
    command: npm run build
    cwd: /var/app/staging
    
  04_set_permissions:
    command: |
      chown -R webapp:webapp /var/app/staging
      chmod -R 755 /var/app/staging