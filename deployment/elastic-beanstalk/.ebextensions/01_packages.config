packages:
  yum:
    git: []
    wget: []
    curl: []

commands:
  01_node_install:
    command: |
      curl -fsSL https://rpm.nodesource.com/setup_18.x | bash -
      yum install -y nodejs
    test: "! node --version"
  
  02_npm_install:
    command: npm install -g pm2
    test: "! pm2 --version"

files:
  "/opt/elasticbeanstalk/hooks/appdeploy/pre/49_create_dirs.sh":
    mode: "000755"
    owner: root
    group: root
    content: |
      #!/bin/bash
      mkdir -p /var/log/app
      chown webapp:webapp /var/log/app
      
  "/opt/elasticbeanstalk/hooks/appdeploy/post/49_restart_services.sh":
    mode: "000755"
    owner: root
    group: root
    content: |
      #!/bin/bash
      # Restart application using PM2
      su webapp -c "cd /var/app/current && pm2 restart all || pm2 start ecosystem.config.js --env production"