# Production Environment Variables Template
# Copy this file to .env.production and fill in your actual values
# DO NOT commit the actual .env.production file to version control

# =============================================================================
# APPLICATION CONFIGURATION
# =============================================================================
NODE_ENV=production
PORT=3000

# Application URLs
FRONTEND_URL=https://your-domain.com
BACKEND_URL=https://api.your-domain.com

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================
# PostgreSQL Database URL
# Format: postgresql://username:password@host:port/database
DATABASE_URL=postgresql://username:password@host:5432/database_name

# Database connection pool settings (optional)
DB_POOL_MIN=2
DB_POOL_MAX=10

# =============================================================================
# AUTHENTICATION & SECURITY
# =============================================================================
# JWT Configuration
JWT_SECRET=your-super-secure-jwt-secret-here-min-32-chars
JWT_EXPIRES_IN=24h

# Session Configuration
SESSION_SECRET=your-super-secure-session-secret-here-min-32-chars
SESSION_MAX_AGE=86400000

# Password hashing
BCRYPT_ROUNDS=12

# =============================================================================
# OAUTH CONFIGURATION
# =============================================================================
# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=https://your-domain.com/auth/google/callback

# Microsoft OAuth
MICROSOFT_CLIENT_ID=your-microsoft-client-id
MICROSOFT_CLIENT_SECRET=your-microsoft-client-secret
MICROSOFT_CALLBACK_URL=https://your-domain.com/auth/microsoft/callback

# OAuth Redirect URLs
LOGIN_REDIRECT_URL=https://your-domain.com/dashboard
LOGOUT_REDIRECT_URL=https://your-domain.com

# =============================================================================
# AWS CONFIGURATION
# =============================================================================
# AWS Credentials (use IAM roles in production when possible)
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
AWS_REGION=us-east-1

# AWS Domain Configuration (for OAuth callbacks)
AWS_DOMAIN=your-lambda-domain.execute-api.us-east-1.amazonaws.com
AWS_GOOGLE_CALLBACK_URL=https://your-lambda-domain.execute-api.us-east-1.amazonaws.com/production/auth/google/callback

# S3 Configuration
S3_BUCKET_NAME=your-app-assets-bucket
S3_REGION=us-east-1

# CloudFront Configuration (if using CDN)
CLOUDFRONT_DISTRIBUTION_ID=your-cloudfront-distribution-id
CLOUDFRONT_DOMAIN=your-cloudfront-domain.cloudfront.net

# =============================================================================
# EXTERNAL API KEYS
# =============================================================================
# OpenAI Configuration
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_MODEL=gpt-4
OPENAI_MAX_TOKENS=2000

# Other API Keys (add as needed)
# STRIPE_SECRET_KEY=sk_live_your-stripe-secret-key
# TWILIO_ACCOUNT_SID=your-twilio-account-sid
# TWILIO_AUTH_TOKEN=your-twilio-auth-token

# =============================================================================
# EMAIL CONFIGURATION
# =============================================================================
# SMTP Configuration (for sending emails)
SMTP_HOST=smtp.your-provider.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@your-domain.com
SMTP_PASS=your-email-password

# AWS SES Configuration (alternative to SMTP)
# SES_REGION=us-east-1
# SES_ACCESS_KEY_ID=your-ses-access-key
# SES_SECRET_ACCESS_KEY=your-ses-secret-key

# Email addresses
FROM_EMAIL=noreply@your-domain.com
ADMIN_EMAIL=admin@your-domain.com

# =============================================================================
# MONITORING & LOGGING
# =============================================================================
# Log Level (error, warn, info, debug)
LOG_LEVEL=info

# Error Tracking (e.g., Sentry)
# SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id

# Health Check Configuration
HEALTH_CHECK_ENABLED=true
HEALTH_CHECK_INTERVAL=300000

# =============================================================================
# CORS CONFIGURATION
# =============================================================================
# Allowed origins for CORS (comma-separated)
ALLOWED_ORIGINS=https://your-domain.com,https://www.your-domain.com

# =============================================================================
# RATE LIMITING
# =============================================================================
# Rate limiting configuration
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# API-specific rate limits
API_RATE_LIMIT_WINDOW_MS=900000
API_RATE_LIMIT_MAX_REQUESTS=1000

# =============================================================================
# CACHE CONFIGURATION
# =============================================================================
# Redis Configuration (if using Redis for caching/sessions)
# REDIS_URL=redis://localhost:6379
# REDIS_HOST=your-redis-host
# REDIS_PORT=6379
# REDIS_PASSWORD=your-redis-password

# Cache TTL settings (in seconds)
CACHE_TTL=3600
SESSION_CACHE_TTL=86400

# =============================================================================
# WEBSOCKET CONFIGURATION
# =============================================================================
# WebSocket settings
WS_PORT=8080
WS_CORS_ORIGIN=https://your-domain.com

# =============================================================================
# SSL/TLS CONFIGURATION
# =============================================================================
# SSL Certificate paths (for custom domains)
SSL_CERT_PATH=/etc/ssl/certs/your-domain.crt
SSL_KEY_PATH=/etc/ssl/private/your-domain.key

# Force HTTPS redirect
FORCE_HTTPS=true

# =============================================================================
# DEPLOYMENT SPECIFIC
# =============================================================================
# Deployment environment
DEPLOYMENT_ENV=production
DEPLOYMENT_STAGE=production

# Build configuration
BUILD_OPTIMIZE=true
BUILD_MINIFY=true

# =============================================================================
# FEATURE FLAGS
# =============================================================================
# Feature toggles
FEATURE_NEW_AUTH_FLOW=true
FEATURE_BETA_DASHBOARD=false
FEATURE_AI_ASSISTANT=true
FEATURE_EMAIL_NOTIFICATIONS=true

# =============================================================================
# BACKUP & MAINTENANCE
# =============================================================================
# Database backup settings
DB_BACKUP_ENABLED=true
DB_BACKUP_SCHEDULE=0 2 * * *
DB_BACKUP_RETENTION_DAYS=30

# Maintenance mode
MAINTENANCE_MODE=false
MAINTENANCE_MESSAGE="Site is under maintenance. Please check back later."

# =============================================================================
# PERFORMANCE TUNING
# =============================================================================
# Node.js performance settings
NODE_OPTIONS=--max-old-space-size=1024

# Cluster mode (for PM2)
CLUSTER_INSTANCES=max

# =============================================================================
# SECURITY HEADERS
# =============================================================================
# Content Security Policy
CSP_DEFAULT_SRC="'self'"
CSP_SCRIPT_SRC="'self' 'unsafe-inline'"
CSP_STYLE_SRC="'self' 'unsafe-inline'"
CSP_IMG_SRC="'self' data: https:"

# HTTP Security Headers
HSTS_MAX_AGE=31536000
HSTS_INCLUDE_SUBDOMAINS=true